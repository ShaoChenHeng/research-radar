#!/usr/bin/env bash
# 安装 systemd 用户单元并启用 timer。
# 注意：systemd/*.service 里的路径写死为 %h/github-project/research-radar；换目录请改。
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UD="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$UD"
cp "$ROOT/systemd/research-radar.service" "$ROOT/systemd/research-radar.timer" "$UD/"
systemctl --user daemon-reload
systemctl --user enable --now research-radar.timer
echo "[radar] 已安装并启用 research-radar.timer"
systemctl --user list-timers research-radar.timer --no-pager 2>/dev/null | head -3 || true
