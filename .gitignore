# ============================================================
# 代码公开仓 / 数据私有仓 分离
# ============================================================

# ---- 本地配置（用 config.example.toml 复制一份再改）----
config.toml
profile.md

# ---- 数据仓：独立私有 git 仓（内含 digest/ state/ papers/）----
data/

# ---- 密钥 ----
.env
*.env
!*.env.example

# ---- 缓存 ----
__pycache__/
*.pyc

# ---- 工具/编辑器备份（别进公开仓）----
*.bak-*
*.orig
*.rej

# Emacs 字节编译产物
*.elc

# agent-shell 在本仓跑时的会话转写（非项目数据）
.agent-shell/
